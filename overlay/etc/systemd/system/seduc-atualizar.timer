# SEDUC: atualização dos pacotes (atualizar_pacotes.sh), no lugar do unattended-upgrades.
# Verifica 10 minutos depois de ligar e a cada 12 horas ligado. O script só usa a rede
# a cada 3 dias depois de uma atualização completa (1 dia depois de uma incompleta);
# nas outras vezes só lê o status. O atraso aleatório espalha os computadores do
# laboratório para não baixarem todos ao mesmo tempo.
[Unit]
Description=Atualização dos pacotes do sistema (SEDUC)

[Timer]
OnBootSec=10min
OnUnitActiveSec=12h
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
