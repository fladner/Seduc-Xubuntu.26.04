favorites=firefox.desktop,com.google.Chrome.desktop,xfce4-file-manager.desktop,libreoffice-writer.desktop,libreoffice-calc.desktop,xfce4-terminal-emulator.desktop,xfhelp4.desktop
button-title=Applications Menu
button-title[pt]=Menu de Aplicações
button-title[pt_BR]=Menu de Aplicações
button-icon=seduc-logo-menu
show-button-title=false
show-button-icon=true
load-hierarchy=true
launcher-show-name=true
launcher-show-description=false
item-icon-size=1
category-icon-size=0
hover-switch-category=false
favorites-in-recent=true
display-recent-default=false
position-search-alternate=true
command-switchuser=dm-tool switch-to-greeter
show-command-switchuser=false
command-settings=xfce4-settings-manager
show-command-settings=true
command-menueditor=menulibre
show-command-menueditor=true
command-lockscreen=xflock4
show-command-lockscreen=true
command-logout=xfce4-session-logout
show-command-logout=true
search-actions=5

[action0]
name=Man Pages
name[pt]=Páginas de manual
name[pt_BR]=Páginas de manuais

pattern=#
command=exo-open --launch TerminalEmulator man %s
regex=false

[action1]
name=Wikipedia
name[pt]=Wikipédia
name[pt_BR]=Wikipédia

pattern=!w
command=exo-open --launch WebBrowser https://en.wikipedia.org/wiki/%u
regex=false

[action2]
name=Run in Terminal
name[pt]=Executar num Terminal
name[pt_BR]=Executar no terminal

pattern=!
command=exo-open --launch TerminalEmulator %s
regex=false

[action3]
name=Open URI
name[pt]=Abrir URI
name[pt_BR]=Abrir URI

pattern=^(file|http|https):\\/\\/(.*)$
command=exo-open \\0
regex=true

[action4]
name=Search for files
name[pt]=Procurar por ficheiros
name[pt_BR]=Pesquisar por arquivos

pattern=-
command=catfish --path=~ --start %s
regex=false
