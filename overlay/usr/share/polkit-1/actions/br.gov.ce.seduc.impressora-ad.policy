<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Painel "Impressoras SEDUC": o usuário da sessão ativa instala/remove filas
     do servidor de impressão do ad.conf sem a senha do administrador -->
<policyconfig>
  <vendor>SEDUC Ceará</vendor>
  <action id="br.gov.ce.seduc.impressora-ad">
    <description>Instalar impressora do servidor SEDUC</description>
    <message>Instalar impressora do servidor SEDUC</message>
    <icon_name>printer</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/seduc/scripts/instalar_impressora_ad.sh</annotate>
  </action>
</policyconfig>
